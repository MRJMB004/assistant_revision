# Ne jamais versionner backend/.env ni envoyer ces valeurs au frontend.
# Cree un secret aleatoire de 32 caracteres minimum.
JWT_SECRET=remplace-par-un-secret-aleatoire-d-au-moins-32-caracteres

# Facultatif : generation de cours et quiz par Gemini.
GEMINI_API_KEY=

# Facultatif : e-mails de rappel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
